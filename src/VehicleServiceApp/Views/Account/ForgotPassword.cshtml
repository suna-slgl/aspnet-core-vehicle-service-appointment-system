@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="display-1 text-primary mb-3">
                        <i class="bi bi-key"></i>
                    </div>
                    <h2 class="fw-bold">Şifremi Unuttum</h2>
                    <p class="text-muted">Hesabınıza ait email adresini girin.</p>
                </div>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope me-1"></i>Email
                        </label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="ornek@email.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-send me-2"></i>Sıfırlama Bağlantısı Gönder
                        </button>
                    </div>
                </form>

                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Giriş sayfasına dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
