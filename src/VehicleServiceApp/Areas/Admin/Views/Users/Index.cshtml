@model UserListViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Kullanıcılar</h2>
        <p class="text-muted mb-0">Kullanıcı hesaplarını ve erişim durumlarını yönetin.</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Arama</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Ad, soyad veya e-posta" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Durum</label>
                <select name="isActive" class="form-select">
                    <option value="">Tümü</option>
                    <option value="true" selected="@(Model.IsActive == true)">Aktif</option>
                    <option value="false" selected="@(Model.IsActive == false)">Pasif</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>Filtrele
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Kullanıcı</th>
                        <th>Roller</th>
                        <th>Araç</th>
                        <th>Randevu</th>
                        <th>Durum</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@user.FullName</div>
                                    <div class="text-muted small">@user.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                                    {
                                        <div class="text-muted small">@user.PhoneNumber</div>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-secondary me-1">@role</span>
                                    }
                                </td>
                                <td>@user.VehicleCount</td>
                                <td>@user.AppointmentCount</td>
                                <td>
                                    <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                        @(user.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Kayıt bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-end mb-0">
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-isActive="@Model.IsActive">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
