@model ReportFilterViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Raporlar</h2>
        <p class="text-muted mb-0">Randevu, gelir ve teknisyen performansını filtreleyin.</p>
    </div>
    <a asp-action="ExportReportsCsv"
       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
       asp-route-status="@Model.Status"
       asp-route-serviceTypeId="@Model.ServiceTypeId"
       asp-route-technicianId="@Model.TechnicianId"
       class="btn btn-outline-success">
        <i class="bi bi-download me-1"></i>CSV
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="form-select">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="ServiceTypeId" class="form-label"></label>
                <select asp-for="ServiceTypeId" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var serviceType in Model.ServiceTypes)
                    {
                        <option value="@serviceType.Id">@serviceType.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="TechnicianId" class="form-label"></label>
                <select asp-for="TechnicianId" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var technician in Model.Technicians)
                    {
                        <option value="@technician.Id">@technician.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Results != null)
{
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Toplam Randevu</div>
                    <div class="display-6">@Model.Results.TotalAppointments</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Tamamlanan</div>
                    <div class="display-6">@Model.Results.CompletedAppointments</div>
                    <div class="text-muted small">@Model.Results.CompletionRate.ToString("F1")%</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">İptal Edilen</div>
                    <div class="display-6">@Model.Results.CancelledAppointments</div>
                    <div class="text-muted small">@Model.Results.CancellationRate.ToString("F1")%</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Toplam Gelir</div>
                    <div class="display-6">@Model.Results.TotalRevenue.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Hizmet Türü Kırılımı</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Hizmet</th>
                                    <th>Randevu</th>
                                    <th>Gelir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.Results.ServiceTypeStatistics)
                                {
                                    <tr>
                                        <td>@stat.ServiceName</td>
                                        <td>@stat.AppointmentCount</td>
                                        <td>@stat.TotalRevenue.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Teknisyen Kırılımı</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Teknisyen</th>
                                    <th>Randevu</th>
                                    <th>Tamamlanan</th>
                                    <th>Gelir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TechnicianStatistics.Any())
                                {
                                    foreach (var stat in Model.TechnicianStatistics)
                                    {
                                        <tr>
                                            <td>@stat.TechnicianName</td>
                                            <td>@stat.AppointmentCount</td>
                                            <td>@stat.CompletedCount</td>
                                            <td>@stat.TotalRevenue.ToString("C")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">Teknisyen verisi yok.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Randevu Detayları</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Tarih</th>
                            <th>Müşteri</th>
                            <th>Araç</th>
                            <th>Hizmet</th>
                            <th>Teknisyen</th>
                            <th>Durum</th>
                            <th>Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DetailedAppointments.Any())
                        {
                            foreach (var appointment in Model.DetailedAppointments)
                            {
                                <tr>
                                    <td>#@appointment.Id</td>
                                    <td>@appointment.AppointmentDate.ToString("dd.MM.yyyy") @appointment.AppointmentTime.ToString(@"hh\:mm")</td>
                                    <td>
                                        <div>@appointment.CustomerName</div>
                                        <div class="text-muted small">@appointment.CustomerEmail</div>
                                    </td>
                                    <td>@appointment.VehicleInfo</td>
                                    <td>@appointment.ServiceTypeName</td>
                                    <td>@(appointment.TechnicianName ?? "Atanmadı")</td>
                                    <td><span class="badge bg-@appointment.StatusColor">@appointment.StatusDisplay</span></td>
                                    <td>@appointment.ServicePrice.ToString("C")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Filtreye uygun randevu bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
